          <mxGeometry x="930" y="855" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-proposed" value="Proposed feature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="1120" y="855" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-blocker" value="Current blocker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="1310" y="855" width="170" height="40" as="geometry" />
        </mxCell>

