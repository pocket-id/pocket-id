{
	"name": "@pocket-id/ui",
	"version": "0.1.0",
	"description": "The Svelte components and design tokens of Pocket ID",
	"license": "BSD-2-Clause",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pocket-id/pocket-id.git",
		"directory": "packages/ui"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		"./theme.css": "./src/lib/theme.css",
		"./styles.css": "./src/lib/styles.css",
		"./labels": {
			"types": "./src/lib/labels.ts",
			"default": "./src/lib/labels.ts"
		},
		"./utils": {
			"types": "./src/lib/utils/style.ts",
			"default": "./src/lib/utils/style.ts"
		},
		"./*": {
			"types": "./src/lib/components/*/index.ts",
			"svelte": "./src/lib/components/*/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			"./theme.css": "./dist/theme.css",
			"./styles.css": "./dist/styles.css",
			"./labels": {
				"types": "./dist/labels.d.ts",
				"default": "./dist/labels.js"
			},
			"./utils": {
				"types": "./dist/utils/style.d.ts",
				"default": "./dist/utils/style.js"
			},
			"./*": {
				"types": "./dist/components/*/index.d.ts",
				"svelte": "./dist/components/*/index.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"prepack": "svelte-package",
		"check": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.16.0",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.2",
		"bits-ui": "^2.18.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.1.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"bits-ui": "^2.18.1",
		"svelte": "^5.57.1",
		"svelte-sonner": "^1.1.1",
		"tailwindcss": "^4.3.0"
	},
	"peerDependenciesMeta": {
		"svelte-sonner": {
			"optional": true
		}
	}
}
