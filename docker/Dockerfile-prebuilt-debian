# This Dockerfile embeds a pre-built binary for the given Linux architecture
# Binaries are supplied by GoReleaser.
# It behaves like the default distroless image but is based on Debian, with a shell and apt for debugging

FROM debian:stable-slim@sha256:fbfb4059d2127120aa05b6e6064523d2102552f0cf0026ddf0701c12f1f8f3e0

# TARGETARCH can be "amd64" or "arm64"
ARG TARGETARCH
ARG TARGETVARIANT

WORKDIR /app

RUN apt-get update && \
  apt-get install -y --no-install-recommends ca-certificates && \
  rm -rf /var/lib/apt/lists/* && \
  groupadd -g 65532 pocket-id && \
  useradd -u 65532 -g pocket-id -M -d /app -s /bin/sh pocket-id

COPY linux/${TARGETARCH}/${TARGETVARIANT}/pocket-id /app/pocket-id
COPY ./.tmp/frontend.cdx.json /usr/share/doc/pocket-id/frontend.cdx.json

USER 65532:65532

WORKDIR /app/data
WORKDIR /app

EXPOSE 1411 1414/udp
ENV APP_ENV=production

HEALTHCHECK --interval=90s --timeout=5s --start-period=10s --retries=3 CMD [ "/app/pocket-id", "healthcheck" ]

CMD ["/app/pocket-id"]
